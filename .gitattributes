# Keep LF in the working tree on every platform.
#
# Not cosmetic: the canonical writer emits LF, and the round-trip test asserts that
# the committed fixture is byte-identical to its own re-serialisation. Letting git
# check it out with CRLF on Windows would break that test on a fresh clone.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.mp4 binary
*.m4v binary
*.mov binary
*.avi binary
*.mkv binary
*.wmv binary
*.webm binary
*.mpg binary
*.mpeg binary
*.mts binary
*.m2ts binary
*.npz binary
*.fvs binary
# Flame analysis meshes: binary PLY after an ASCII header, which git's text
# detection can take for text and normalise.
*.ply binary

# FDS Fortran records and RLE payloads must never undergo line-ending conversion.
*.sf binary
*.bf binary
*.s3d binary

# Preserve fixed-width padding in excerpts of original FDS text output.
fixtures/fds-results/*.smv whitespace=-blank-at-eol
fixtures/fds-results/*.sz whitespace=-blank-at-eol
